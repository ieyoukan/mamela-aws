## Declares the AwsSecurityGroup: Mamela makes it so, through the provider.
pub fn aws_security_group(graph: Mamela.Graph, r: AwsSecurityGroup) -> Mamela.Graph {
  spec = List.flatten(
    [
      [("boundary", Text(r.boundary))],
      [("vpc", Text(r.vpc.name))],
      [("description", Text(r.description))],
      if List.is_empty(r.ingress) {
        []
      } else {
        [("ingress", Items(r.ingress.map(|x| ingress_spec(x))))]
      },
    ],
  )
  after = List.flatten([[aws_vpc_ref(r.vpc)], List.flatten(r.ingress.map(|x| ingress_after(x)))])
  Mamela.provided_after(graph, PROVIDER, "AwsSecurityGroup", r.name, spec, after)
