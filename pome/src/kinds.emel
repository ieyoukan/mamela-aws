## A Ingress, part of a spec.
##
## `port`: the TCP port
## `from_group`: from the members of this group (optional)
## `cidr`: or from this CIDR block (optional)
pub type Ingress(port: Int, from_group: Option[AwsSecurityGroup], cidr: Option[String])

fn ingress_spec(o: Ingress) -> Dynamic {
  Dynamic.object(
    List.flatten(
      [
        [("port", integer(o.port))],
        o.from_group match {
          Some(v) -> [("fromGroup", Text(v.name))]
          None    -> []
        },
        o.cidr match {
          Some(v) -> [("cidr", Text(v))]
          None    -> []
        },
      ],
    ),
  )
}

fn ingress_after(o: Ingress) -> List[Ref] {
  List.flatten(
    [
      o.from_group match {
        Some(v) -> [aws_security_group_ref(v)]
        None    -> []
      },
    ],
  )
}

fn integer(n: Int) -> Dynamic {
  Dynamic.Number(Number.from_int(n))
}
