  )
  after = List.flatten(
    [
      [aws_subnet_ref(r.subnet)],
      [aws_security_group_ref(r.security_group)],
      r.cluster match {
        Some(v) -> [aws_ecs_cluster_ref(v)]
        None    -> []
      },
      r.role match {
        Some(v) -> [aws_iam_role_ref(v)]
        None    -> []
      },
    ],
  )
  Mamela.provided_after(graph, PROVIDER, "AwsInstance", r.name, spec, after)
