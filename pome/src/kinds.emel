## An ECS service that keeps count tasks of a task definition running. With 0 tasks, it is a way to run one-off tasks: `mamela act --confirm <name> run-task` runs one, as the service would.
##
## `boundary`: the boundary (the guard's): it tags the service
## `task_definition`: its tasks' definition (the latest revision)
## `count`: how many tasks it keeps running (0: a service to run one-off tasks with run-task)
## `launch`: where its tasks run: EC2 (the cluster's container instances), FARGATE or FARGATE_SPOT
## `subnet`: Fargate: the subnet of its tasks (optional)
## `security_group`: Fargate: their security group (optional)
## `public_ip`: Fargate: a public IP address (to pull images without a NAT gateway) (optional)
pub type AwsEcsService(
  name: String,
  boundary: String,
  cluster: AwsEcsCluster,
  task_definition: AwsEcsTaskDefinition,
  count: Int,
  launch: String,
  subnet: Option[AwsSubnet],
  security_group: Option[AwsSecurityGroup],
  public_ip: Option[Bool],
)

## Declares the AwsEcsService: Mamela makes it so, through the provider.
pub fn aws_ecs_service(graph: Mamela.Graph, r: AwsEcsService) -> Mamela.Graph {
  spec = List.flatten(
    [
      [("boundary", Text(r.boundary))],
      [("cluster", Text(r.cluster.name))],
      [("taskDefinition", Text(r.task_definition.name))],
      [("count", integer(r.count))],
      [("launch", Text(r.launch))],
      r.subnet match {
        Some(v) -> [("subnet", Text(v.name))]
        None    -> []
      },
      r.security_group match {
        Some(v) -> [("securityGroup", Text(v.name))]
        None    -> []
      },
      r.public_ip match {
        Some(v) -> [("publicIp", Dynamic.Bool(v))]
        None    -> []
      },
    ],
  )
  after = List.flatten(
    [
      [aws_ecs_cluster_ref(r.cluster)],
      [aws_ecs_task_definition_ref(r.task_definition)],
      r.subnet match {
        Some(v) -> [aws_subnet_ref(v)]
        None    -> []
      },
      r.security_group match {
        Some(v) -> [aws_security_group_ref(v)]
        None    -> []
      },
    ],
  )
  Mamela.provided_after(graph, PROVIDER, "AwsEcsService", r.name, spec, after)
}

## A reference to the AwsEcsService, for what needs it first.
pub fn aws_ecs_service_ref(r: AwsEcsService) -> Ref {
  Ref(kind: "AwsEcsService", name: r.name)
}

## The values of AwsIamRoleTrust.
pub enum AwsIamRoleTrust {
  EcsTasks
  Ec2
}

fn aws_iam_role_trust_text(v: AwsIamRoleTrust) -> Dynamic {
  v match {
    EcsTasks -> Text("ecs-tasks")
    Ec2      -> Text("ec2")
  }
}

## The values of AwsIamRolePolicy.
pub enum AwsIamRolePolicy {
  EcsTaskExecution
  EcsForEc2
}

fn aws_iam_role_policy_text(v: AwsIamRolePolicy) -> Dynamic {
  v match {
    EcsTaskExecution -> Text("ecs-task-execution")
    EcsForEc2        -> Text("ecs-for-ec2")
  }
}

## A Ingress, part of a spec.
##
## `port`: the TCP port
## `from_group`: from the members of this group (optional)
## `cidr`: or from this CIDR block (optional)
pub type Ingress(port: Int, from_group: Option[AwsSecurityGroup], cidr: Option[String])

fn ingress_spec(o: Ingress) -> Dynamic {
  Dynamic.object(
    List.flatten(
      [
        [("port", integer(o.port))],
        o.from_group match {
          Some(v) -> [("fromGroup", Text(v.name))]
          None    -> []
        },
        o.cidr match {
          Some(v) -> [("cidr", Text(v))]
          None    -> []
        },
      ],
    ),
  )
}

fn ingress_after(o: Ingress) -> List[Ref] {
  List.flatten(
    [
      o.from_group match {
        Some(v) -> [aws_security_group_ref(v)]
        None    -> []
      },
    ],
  )
}

## A HostContainer, part of a spec.
##
## `image`: the container image (registry/path:tag)
## `port`: its TCP port, published on the instance
pub type HostContainer(image: String, port: Int)

fn host_container_spec(o: HostContainer) -> Dynamic {
  Dynamic.object(List.flatten([[("image", Text(o.image))], [("port", integer(o.port))]]))
}

## A Container, part of a spec.
##
## `container_name`: the container's name
## `image`: its image (registry/path:tag)
## `command`: its arguments (the image's entrypoint runs them) (optional)
## `environment`: (optional)
## `ports`: (optional)
## `memory_mi_b`: its hard limit of memory on EC2 (MiB) (optional)
pub type Container(
  container_name: String,
  image: String,
  command: List[String],
  environment: List[Env],
  ports: List[Port],
  memory_mi_b: Option[Int],
)

fn container_spec(o: Container) -> Dynamic {
  Dynamic.object(
    List.flatten(
      [
        [("containerName", Text(o.container_name))],
        [("image", Text(o.image))],
        if List.is_empty(o.command) {
          []
        } else {
          [("command", Items(o.command.map(|x| Text(x))))]
        },
        if List.is_empty(o.environment) {
          []
        } else {
          [("environment", Items(o.environment.map(|x| env_spec(x))))]
        },
        if List.is_empty(o.ports) { [] } else { [("ports", Items(o.ports.map(|x| port_spec(x))))] },
        o.memory_mi_b match {
          Some(v) -> [("memoryMiB", integer(v))]
          None    -> []
        },
      ],
    ),
  )
}

fn container_after(o: Container) -> List[Ref] {
  List.flatten([List.flatten(o.environment.map(|x| env_after(x)))])
}

## A Env, part of a spec.
##
## `variable`: the variable's name
## `value`: (optional)
## `instance_ip`: or the private IP address of this instance (optional)
## `prefix`: before the instance's address (http://) (optional)
pub type Env(
  variable: String,
  value: Option[String],
  instance_ip: Option[AwsInstance],
  prefix: Option[String],
)

fn env_spec(o: Env) -> Dynamic {
  Dynamic.object(
    List.flatten(
      [
        [("variable", Text(o.variable))],
        o.value match {
          Some(v) -> [("value", Text(v))]
          None    -> []
        },
        o.instance_ip match {
          Some(v) -> [("instanceIp", Text(v.name))]
          None    -> []
        },
        o.prefix match {
          Some(v) -> [("prefix", Text(v))]
          None    -> []
        },
      ],
    ),
  )
}

fn env_after(o: Env) -> List[Ref] {
  List.flatten(
    [
      o.instance_ip match {
        Some(v) -> [aws_instance_ref(v)]
        None    -> []
      },
    ],
  )
}

## A Port, part of a spec.
##
## `container`: the container's TCP port
## `host`: on EC2, the instance's port (none: a port ECS chooses) (optional)
pub type Port(container: Int, host: Option[Int])

fn port_spec(o: Port) -> Dynamic {
  Dynamic.object(
    List.flatten(
      [
        [("container", integer(o.container))],
        o.host match {
          Some(v) -> [("host", integer(v))]
          None    -> []
        },
      ],
    ),
  )
}

fn integer(n: Int) -> Dynamic {
  Dynamic.Number(Number.from_int(n))
}
