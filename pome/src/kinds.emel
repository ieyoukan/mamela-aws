## `log_group`: where its containers' logs go (optional)
pub type AwsEcsTaskDefinition(
  name: String,
  boundary: String,
  launch: String,
  cpu: Int,
  memory_mi_b: Int,
  execution_role: Option[AwsIamRole],
  log_group: Option[AwsLogGroup],
  containers: List[Container],
)

## Declares the AwsEcsTaskDefinition: Mamela makes it so, through the provider.
pub fn aws_ecs_task_definition(graph: Mamela.Graph, r: AwsEcsTaskDefinition) -> Mamela.Graph {
  spec = List.flatten(
    [
      [("boundary", Text(r.boundary))],
      [("launch", Text(r.launch))],
      [("cpu", integer(r.cpu))],
      [("memoryMiB", integer(r.memory_mi_b))],
      r.execution_role match {
        Some(v) -> [("executionRole", Text(v.name))]
        None    -> []
      },
      r.log_group match {
        Some(v) -> [("logGroup", Text(v.name))]
        None    -> []
      },
      [("containers", Items(r.containers.map(|x| container_spec(x))))],
    ],
  )
  after = List.flatten(
    [
      r.execution_role match {
        Some(v) -> [aws_iam_role_ref(v)]
        None    -> []
      },
      r.log_group match {
        Some(v) -> [aws_log_group_ref(v)]
        None    -> []
      },
      List.flatten(r.containers.map(|x| container_after(x))),
    ],
  )
  Mamela.provided_after(graph, PROVIDER, "AwsEcsTaskDefinition", r.name, spec, after)
}

## A reference to the AwsEcsTaskDefinition, for what needs it first.
pub fn aws_ecs_task_definition_ref(r: AwsEcsTaskDefinition) -> Ref {
  Ref(kind: "AwsEcsTaskDefinition", name: r.name)
